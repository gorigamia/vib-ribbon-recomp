diff --git a/runtime/src/psx_host_menu.c b/runtime/src/psx_host_menu.c
index 6f38590..408d4df 100644
--- a/runtime/src/psx_host_menu.c
+++ b/runtime/src/psx_host_menu.c
@@ -1,7 +1,19 @@
 #include "psx_host_menu.h"
 #include "psx_runtime_menu.h"
 #include "psx_savestate_menu.h"
+
+#include <stdatomic.h>
+
+static _Atomic(PsxHostMenuImageFn) s_image_provider = NULL;
+
+int psx_host_menu_set_image_provider(PsxHostMenuImageFn fn) {
+    atomic_store_explicit(&s_image_provider, fn, memory_order_release);
+    return 1;
+}
+
 int psx_host_menu_overlay_image(const uint32_t **pixels, int *w, int *h) {
+    PsxHostMenuImageFn fn = atomic_load_explicit(&s_image_provider, memory_order_acquire);
+    if (fn && fn(pixels, w, h)) return 1;
     if (psx_runtime_menu_overlay_image(pixels, w, h)) return 1;
     return psx_savestate_menu_overlay_image(pixels, w, h);
 }
