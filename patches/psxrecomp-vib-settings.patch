+extern "C" int vib_set_cdda_playlist(const uint8_t** sectors, const uint32_t* counts,
+                                     uint32_t track_count) {
+    auto& s=PSXRecompV4::state();
+    s.audio_tracks.clear();
+    if(!sectors || !counts || !track_count || track_count>98) return 0;
+    uint32_t lba=150;
+    for(uint32_t i=0;i<track_count;i++) {
+        if(!sectors[i] || !counts[i]) { s.audio_tracks.clear(); return 0; }
+        s.audio_tracks.push_back({lba,counts[i],0,sectors[i]});
+        lba+=counts[i];
+    }
+    s.disc_enabled=true;
+    return (int)track_count;
+}
